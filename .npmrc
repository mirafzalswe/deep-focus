# better-sqlite3 13 ships ready N-API prebuilds (prebuilds/*.node) and sets "gypfile": false, but npm builds
# from package-lock, which does not keep that flag: npm sees binding.gyp and runs "node-gyp rebuild", which needs
# Visual Studio. No dependency here needs an install script on Windows (electron downloads its binary on first
# use or via "npm run electron:install"), so install scripts are off for this project.
ignore-scripts=true
